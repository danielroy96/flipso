App(
    appid="flipso",
    name="Flipso",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipso_app",
    targets=["f7"],
    stack_size=4 * 1024,
    fap_category="NFC",
    fap_icon="flipso.png",
    fap_author="danielroy96",
    fap_version="1.0",
    fap_description="Read UK ITSO public transport smartcards",
    fap_weburl="https://github.com/danielroy96/flipso",
    sources=[
        "flipso.c",
        "reader/flipso_reader.c",
        "reader/flipso_desfire.c",
        "reader/flipso_desfire_media.c",
        "reader/flipso_transport.c",
        "reader/flipso_scan_session.c",
        "reader/flipso_cmd2.c",
        "reader/flipso_type2.c",
        "reader/flipso_media.c",
        "cards/*.c",
        "lookup/flipso_operators.c",
        "lookup/flipso_stations.c",
        "lookup/flipso_naptan.c",
        "format/*.c",
        "format/product/*.c",
        "itso/*.c",
        "itso/media/*.c",
        "itso/ipe/*.c",
        "scenes/*.c",
        "views/*.c",
    ],
    fap_file_assets="assets",
    fap_icon_assets="images",
    requires=[
        "gui",
        "notification",
        "dialogs",
        "storage",
    ],
)
