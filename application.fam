App(
    appid="flipso",
    name="Flipso",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipso_app",
    stack_size=4 * 1024,
    fap_category="NFC",
    fap_icon="flipso.png",
    fap_author="danielroy96",
    fap_version="1.0",
    fap_description="Read UK ITSO public transport smartcards",
    fap_weburl="https://github.com/danielroy96/flipso",
    # Listed explicitly: a bare "*.c" is matched recursively and would pull in the
    # host-side decoder tests under tools/.
    sources=[
        "flipso.c",
        "reader/flipso_reader.c",
        "reader/flipso_scan_session.c",
        "reader/flipso_cmd2.c",
        "reader/flipso_type2.c",
        "reader/flipso_media.c",
        "cards/flipso_capture.c",
        "cards/flipso_saved.c",
        "lookup/flipso_operators.c",
        "lookup/flipso_stations.c",
        "lookup/flipso_naptan.c",
        "format/flipso_format.c",
        "format/flipso_format_product.c",
        "format/flipso_format_card.c",
        "format/flipso_format_journeys.c",
        "itso/*.c",
        "scenes/*.c",
        "views/*.c",
    ],
    # The station table, bundled into the .fap as a non-loadable section and
    # unpacked by the firmware to /ext/apps_assets/flipso/. It never reaches
    # RAM: see tools/stations/FORMAT.md. The stop table is deliberately NOT here
    # - at 21 MB it would be re-uploaded on every install - and ships in data/
    # for copying to the card instead; see data/README.md.
    fap_file_assets="assets",
    # Compiled into the .fap as I_<name> symbols in flipso_icons.h. The pixel
    # art they are generated from lives in tools/icons/build_icons.py.
    fap_icon_assets="images",
    requires=[
        "gui",
        "notification",
        # Saved cards: the file browser and the "cannot save" message both come
        # from the dialogs service.
        "dialogs",
        "storage",
    ],
)
